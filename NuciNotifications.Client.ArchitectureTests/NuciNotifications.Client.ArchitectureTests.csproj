<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuciNotifications.Client.ArchitectureTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NuciNotifications.Client/NuciNotifications.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../NuciNotifications.Client/**/*.cs" Exclude="../NuciNotifications.Client/bin/**/*.cs;../NuciNotifications.Client/obj/**/*.cs">
      <LogicalName>ProductionSources/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../NuciNotifications.Client.UnitTests/**/*.cs" Exclude="../NuciNotifications.Client.UnitTests/bin/**/*.cs;../NuciNotifications.Client.UnitTests/obj/**/*.cs">
      <LogicalName>UnitTestSources/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../NuciNotifications.Client.ArchitectureTests/**/*.cs" Exclude="../NuciNotifications.Client.ArchitectureTests/bin/**/*.cs;../NuciNotifications.Client.ArchitectureTests/obj/**/*.cs">
      <LogicalName>ArchitectureTestSources/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../NuciNotifications.Client.slnx">
      <LogicalName>ProjectFiles/NuciNotifications.Client.slnx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../NuciNotifications.Client/NuciNotifications.Client.csproj">
      <LogicalName>ProjectFiles/NuciNotifications.Client/NuciNotifications.Client.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../NuciNotifications.Client.UnitTests/NuciNotifications.Client.UnitTests.csproj">
      <LogicalName>ProjectFiles/NuciNotifications.Client.UnitTests/NuciNotifications.Client.UnitTests.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../NuciNotifications.Client.ArchitectureTests/NuciNotifications.Client.ArchitectureTests.csproj">
      <LogicalName>ProjectFiles/NuciNotifications.Client.ArchitectureTests/NuciNotifications.Client.ArchitectureTests.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../**/*.md;../**/*.csproj;../**/*.slnx;../LICENSE" Exclude="../**/bin/**/*;../**/obj/**/*">
      <LogicalName>RepositoryFiles/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../.github/workflows/*.yml">
      <LogicalName>RepositoryFiles/.github/workflows/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>